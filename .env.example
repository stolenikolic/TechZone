# Supabase – copy to .env.local and fill in from project settings
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# For running DB migrations: Project Settings > Database > Connection string (URI)
# DATABASE_URL=

# Public site URL (auth email links, OAuth redirects, metadata)
# Dev: http://localhost:3000  |  Prod: https://your-domain.com
# Note: SSR admin API calls in `npm run dev` always use http://127.0.0.1:PORT (see site-url.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Viber chat on product page (E.164, e.g. +38761123456)
# NEXT_PUBLIC_VIBER_PHONE=+38761123456

# --- Supabase Dashboard (Auth) — configure manually ---
# Authentication > URL Configuration:
#   Site URL = NEXT_PUBLIC_SITE_URL
#   Redirect URLs:
#     {SITE_URL}/auth/callback
#     {SITE_URL}/auth/update-password
# Authentication > Providers: enable Email (confirm signup), Google, Facebook
# Authentication > Email Templates: customize Confirm signup / Reset password (bs)
# After first signup, promote admin in SQL:
#   UPDATE public.profiles SET role = 'admin' WHERE id = '<user-uuid>';

# OpenAI – for AI attribute generation (lib/ai/openai.ts, /api/ai/generate-attributes)
OPENAI_API_KEY=

# Google Gemini – for AI product descriptions (lib/ai/AiProvider.ts, run-ai-descriptions)
GEMINI_API_KEY=
# AI_DESCRIPTIONS_MODEL=gemini-2.0-flash
# AI_DESCRIPTIONS_AUTO_APPROVE=1

# Pricing (lib/pricing) — primary source is DB table `pricing_settings` (edit via /admin/pricing).
# Env PRICING_* is only a fallback when DB columns kurs_eur / eur_km_rate / pdv_bih are still NULL.
# PRICING_HUF_EUR_RATE=410
# PRICING_EUR_KM_RATE=1.95
# PRICING_PDV=1.17

# Supplier HTML importers — 0 = no per-run product cap (full category scrape)
# PCX_MAX_PRODUCTS_PER_RUN=0
# FIRSTSHOP_MAX_PRODUCTS_PER_RUN=0
# PCLAND_MAX_PRODUCTS_PER_RUN=0
# OAZIS_MAX_PRODUCTS_PER_RUN=0
# KONZOLVILAG_MAX_PRODUCTS_PER_RUN=0

# Background jobs (lib/jobs/job-runner.ts)
# JOB_TRIGGERED_BY=manual

# iPon XML feed sync (cijene + deaktivacija) — odvojen cron svakih 2h
# IPON_XML_FEED_URL=
# IPON_XML_FIXTURE=./fixtures/ipon-xml-sample.xml
# IPON_XML_MIN_ITEMS=100000
# IPON_XML_BATCH_SIZE=500
# IPON_XML_DEACTIVATE_CHUNK=100
# IPON_XML_PARALLEL_BATCHES=3
# IPON_XML_DB_PAGE_SIZE=1000  (max 1000 — Supabase/PostgREST limit po upitu)

# iPon API import — discovery mode (default): samo novi artikli + detekcija slike
# IPON_IMPORT_MODE=discovery
# IPON_IMPORT_MODE=full
# IPON_PAGE_DELAY_MS=0
# IPON_BEFORE_LIST_API_MS=0
# IPON_WARMUP_GAP_MS=300

# iPon repair: re-ingest slike iz raw_json u product_images (jednokratno / održavanje)
# npm run ipon:repair-images -- --dry-run
# npm run ipon:repair-images -- --limit 50
# npm run ipon:repair-images -- --stale-only
# npm run ipon:repair-images -- --all
