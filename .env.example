# Supabase – copy to .env.local and fill in from project settings
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_PROJECT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# For running DB migrations: Project Settings > Database > Connection string (URI)
# DATABASE_URL=

# OpenAI – for AI attribute generation (lib/ai/openai.ts, /api/ai/generate-attributes)
OPENAI_API_KEY=

# Pricing (lib/pricing) — primary source is DB table `pricing_settings` (edit via /admin/pricing).
# Env PRICING_* is only a fallback when DB columns kurs_eur / eur_km_rate / pdv_bih are still NULL.
# PRICING_HUF_EUR_RATE=410
# PRICING_EUR_KM_RATE=1.95
# PRICING_PDV=1.17
