{
  "name": "bazaar-next",
  "version": "7.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "set-root": "bazaar set-root",
    "lint": "next lint",
    "lint:fix": "eslint . --fix",
    "log": "npm run build && npm start >> server.log 2>&1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract-hd-specs": "tsx scripts/extract-hard-disk-specs.ts",
    "run-ssd-attributes": "tsx scripts/run-ssd-attributes.ts",
    "worker:ai": "tsx scripts/run-ai-worker.ts",
    "ipon:import-products": "tsx scripts/run-ipon-import-products.ts",
    "ipon:scrape-details": "tsx scripts/run-ipon-scrape-details.ts",
    "ipon:scrape-details:procesori": "cross-env IPON_SCRAPE_CATEGORY=procesori IPON_SCRAPE_UNTIL_EMPTY=1 tsx scripts/run-ipon-scrape-details.ts",
    "ipon:scrape-details:maticne-ploce": "cross-env IPON_SCRAPE_CATEGORY=maticne-ploce IPON_SCRAPE_UNTIL_EMPTY=1 tsx scripts/run-ipon-scrape-details.ts",
    "ipon:scrape-details:maticne-ploce:full": "cross-env IPON_SCRAPE_CATEGORY=maticne-ploce IPON_SCRAPE_UNTIL_EMPTY=1 IPON_SCRAPE_BATCH_SIZE=15 IPON_SCRAPE_BATCH_SIZE_MAX=20 IPON_SCRAPE_MAX_DETAIL_REQUESTS=10000 IPON_SCRAPE_PRODUCT_DELAY_MIN_MS=15000 IPON_SCRAPE_PRODUCT_DELAY_JITTER_MS=30000 IPON_SCRAPE_BATCH_GAP_MS=180000 tsx scripts/run-ipon-scrape-details.ts",
    "ipon:scrape-details:maticne-ploce:dry": "cross-env IPON_SCRAPE_CATEGORY=maticne-ploce IPON_SCRAPE_DRY_RUN=1 tsx scripts/run-ipon-scrape-details.ts",
    "ipon:sync": "tsx scripts/run-ipon-sync.ts",
    "pcx:import-products": "tsx scripts/run-pcx-import-products.ts",
    "pcx:import-products:full": "cross-env PCX_MAX_PRODUCTS_PER_RUN=0 tsx scripts/run-pcx-import-products.ts",
    "test:auto-link": "tsx scripts/test-match-supplier-product.ts && tsx scripts/test-auto-link-import-integration.ts",
    "test:pricing": "tsx scripts/test-pricing-engine.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.6",
    "@mui/lab": "^7.0.1-beta.20",
    "@mui/material": "^7.3.6",
    "@mui/material-nextjs": "^7.3.6",
    "@mui/x-date-pickers": "^8.23.0",
    "@next/third-parties": "^16.1.1",
    "@supabase/supabase-js": "^2.98.0",
    "apexcharts": "^5.3.6",
    "axios": "^1.13.2",
    "axios-mock-adapter": "^2.1.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^25.7.3",
    "lodash": "^4.17.21",
    "next": "16.1.1",
    "next-i18next": "^15.4.3",
    "nextjs-toploader": "^3.9.17",
    "notistack": "^3.0.2",
    "openai": "^6.27.0",
    "overlayscrollbars-react": "^0.5.6",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-apexcharts": "^1.9.0",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.70.0",
    "react-i18next": "^16.5.1",
    "react-insta-stories": "^2.8.0",
    "react-scroll": "^1.9.3",
    "sharp": "^0.34.5",
    "stylis": "^4.3.6",
    "stylis-plugin-rtl": "^2.1.1",
    "use-mask-input": "^3.5.2",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.21",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/react-scroll": "^1.8.10",
    "@types/stylis": "^4.2.7",
    "bazaar-tools": "^2.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.0",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  }
}
